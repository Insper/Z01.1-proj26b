WIDTH=16;
DEPTH=30;

ADDRESS_RADIX=UNS;
DATA_RADIX=BIN;

CONTENT BEGIN
        0 : 0000000100001101;
        5 : 0000000000000101;
        6 : 0000000000000000;
        7 : 0000000000000000;
      256 : 0000010000000000;
      257 : 0000100000000000;
      258 : 0001000000000000;
      259 : 0000000000000001;
      260 : 0000000000000010;
      261 : 0000000000000011;
      262 : 0000000000000100;
      263 : 0000000000000101;
      264 : 0000000000000110;
      265 : 0000000000000111;
      266 : 0000000000001000;
      267 : 0000000000001001;
      268 : 0000000000001010;
END;
